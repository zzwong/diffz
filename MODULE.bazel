    edition = "2024",
    versions = ["1.99.0"],
    sha256s = {
        "rustc-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "77171ba2a0345fdf2abc4fedda55d6de078dae7a68527c28be8c77dcc9604bd5",
        "clippy-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "982442e32ad8dd3f0bb3a30db74038da5f71fd9bf1a865cc71da8ea5d4ec71ec",
        "cargo-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "d7674918d28093097614cd9728b6ca60db9ea3038f640f0bd1e9a4188c7568ce",
        "llvm-tools-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "91a6db5668c08ee68e330e5b0fda27c11b79b90592627e89f7c5db12af2ff0ba",
        "rust-std-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "3e58dff2d0b72196b5ea4e90536e174d400de88564a52694686b81e091169933",
    },
    extra_target_triples = [],
    opt_level = {"fastbuild": "2", "dbg": "0", "opt": "3"},
    extra_rustc_flags = ["-Cdebuginfo=0", "-Cdebug-assertions=yes", "-Coverflow-checks=yes", "-Ccodegen-units=16", "-Cembed-bitcode=no"],
    extra_exec_rustc_flags = ["-Copt-level=2", "-Cdebuginfo=0", "-Cdebug-assertions=yes", "-Coverflow-checks=yes", "-Ccodegen-units=16", "-Cembed-bitcode=no"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(name = "crates", cargo_lockfile = "//:Cargo.lock", manifests = ["//:Cargo.toml", "//:crates/core/Cargo.toml", "//:crates/adapters/Cargo.toml", "//:crates/ui/Cargo.toml", "//:crates/app/Cargo.toml", "//vendor/gpui-pre-linux:Cargo.toml"], supported_platform_triples = ["x86_64-unknown-linux-gnu"], skip_cargo_lockfile_overwrite = True, isolated = False)
crate.annotation(crate = "gpui-pre", build_script_env = {"DEBUG": "true"}, rustc_flags = ["-Cdebuginfo=1"])
crate.annotation(crate = "gpui-pre-linux", rustc_flags = ["-Cdebuginfo=1"], override_target_lib = "//:gpui_linux", additive_build_file = "//bazel:gpui-linux-sources.BUILD.bazel")
crate.annotation(crate = "gpui-pre-platform", rustc_flags = ["-Cdebuginfo=1"])
crate.annotation(crate = "gpui-pre-wgpu", rustc_flags = ["-Cdebuginfo=1"])
crate.annotation(crate = "gpui-base", rustc_flags = ["-Cdebuginfo=1"])
crate.annotation(crate = "gpui-component", gen_build_script = "off", rustc_flags = ["-Cdebuginfo=1"], compile_data = ["@crates__gpui-kit-assets-0.7.3//:icons"], rustc_env = {"GPUI_KIT_DEFAULT_ICONS_DIR": "$${pwd}/external/rules_rust++crate+crates__gpui-kit-assets-0.7.3/assets/icons"})
crate.annotation(crate = "gpui-kit", rustc_flags = ["-Cdebuginfo=1"])
use_repo(crate, "crates")

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(name = "gpui_linux_local", path = "vendor/gpui-pre-linux", build_file = "//bazel:gpui-linux.BUILD.bazel")
override_repo(crate, **{"crates__gpui-pre-linux-0.3.9": "gpui_linux_local"})

crate.annotation(crate = "gpui-kit-assets", rustc_flags = ["-Cdebug-assertions=no"], build_script_env = {"DEBUG": "false"}, additive_build_file_content = 'filegroup(name = "icons", srcs = glob(["assets/icons/**"]), visibility = ["//visibility:public"])')
