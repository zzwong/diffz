# Experimental Linux build; Cargo remains the default build system.
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:crates.bzl", "diffz_crate", "workspace_rustc_flags")

exports_files(["Cargo.toml", "Cargo.lock", "crates/core/Cargo.toml", "crates/adapters/Cargo.toml", "crates/ui/Cargo.toml", "crates/app/Cargo.toml"])
filegroup(name = "fixtures", srcs = glob(["fixtures/**", "crates/*/tests/fixtures/**"]))
# Only the patch bytes are embedded by crates/adapters/src/fixtures.rs. The
# catalog, before/after files, test extensions and README are runtime test data.
filegroup(name = "fixture_patches", srcs = glob(["fixtures/*/change.patch"]))

CORE_TESTS = diffz_crate(
    name = "core", package = "crates/core", crate_name = "diffz_core",
    features = ["default", "syntax", "gleam", "wasm"], deps = [],
    compile_data = glob(["crates/core/wit/**"]),
)
ADAPTER_TESTS = diffz_crate(
    name = "adapters", package = "crates/adapters", crate_name = "diffz_adapters",
    features = [], deps = [":core"],
    compile_data = [":fixture_patches"] + glob(["crates/adapters/src/**/*.sql"]),
)
UI_TESTS = diffz_crate(
    name = "ui", package = "crates/ui", crate_name = "diffz_ui",
    features = ["default", "syntax"], deps = [":core"],
    compile_data = glob(["crates/ui/icons/**"]),
    unit_compile_data = ["fixtures/split-asymmetric/change.patch"],
)
APP_TESTS = diffz_crate(
    name = "app", package = "crates/app", crate_name = "diffz",
    features = ["default", "desktop", "syntax", "wasm"], deps = [":core", ":adapters", ":ui"],
    unit_compile_data = ["packaging/linux/io.github.zzwong.Diffz.desktop"],
)

alias(name = "gpui_linux", actual = "//vendor/gpui-pre-linux:gpui_linux", visibility = ["//visibility:public"])
rust_binary(
    name = "store_size",
    crate_root = "crates/adapters/examples/store_size.rs",
    srcs = ["crates/adapters/examples/store_size.rs"],
    edition = "2024",
    deps = [":core", ":adapters"] + all_crate_deps(package_name = "crates/adapters", normal = True, normal_dev = True),
    rustc_flags = workspace_rustc_flags(),
)

test_suite(name = "tests", tests = CORE_TESTS + ADAPTER_TESTS + UI_TESTS + APP_TESTS)
filegroup(name = "all_build", testonly = True, srcs = [":diffz", ":store_size"] + CORE_TESTS + ADAPTER_TESTS + UI_TESTS + APP_TESTS)
