+    fn frame_waker(&self) -> Option<Rc<dyn Fn()>> {
+        let state = self.0.state.borrow();
+        let client = state.client.clone();
+        let executor = state.executor.clone();
+        let x_window = self.0.x_window;
+        Some(Rc::new(move || {
+            if !client.try_request_frame(x_window) {
+                // Input callbacks can invalidate while the client is still borrowed to
+                // dispatch the X11 event. Retry after that dispatch releases the borrow.
+                let client = client.clone();
+                executor
+                    .spawn(async move { client.request_frame(x_window) })
+                    .detach();
+            }
+        }))
+    }
+
     fn on_request_frame(&self, callback: Box<dyn FnMut(RequestFrameOptions)>) {
         self.0.callbacks.borrow_mut().request_frame = Some(callback);
     }
