+fn wake_frame_source(client: &X11ClientStatePtr, executor: &ForegroundExecutor, x_window: u32) {
+    if !client.try_request_frame(x_window) {
+        // Input callbacks can invalidate while the client is still borrowed to dispatch the X11 event.
+        let client = client.clone();
+        executor
+            .spawn(async move { client.request_frame(x_window) })
+            .detach();
+    }
+}
